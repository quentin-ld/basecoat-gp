{
    "name": "basecoat-gp-theme/basecoat-gp-theme",
    "description": "",
    "type": "wordpress-theme",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Quentin Le Duff",
            "email": "quentin@holdmywp.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "wp-cli/wp-cli-bundle": "v2.11.0",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "squizlabs/php_codesniffer": "^3.11",
        "wp-coding-standards/wpcs": "^3.1",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "infection/infection": "^0.35",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "sirbrillig/phpcs-variable-analysis": "^2.11"
    },
    "scripts": {
        "lint:php": "bash bin/harness lint",
        "harness": "bash bin/harness",
        "harness:verify": "bash bin/harness verify",
        "harness:pot": "bash bin/harness pot",
        "harness:zip": "bash bin/harness zip",
        "setup": "bash bin/harness setup",
        "lint:wpcs": "bash bin/harness lint:wpcs",
        "lint:wpcs:fix": "bash bin/harness lint:fix",
        "lint:pcp": "bash bin/harness pcp",
        "make:pot": "bash bin/harness pot",
        "verify:php": [
            "@lint:php"
        ],
        "verify:all": [
            "@lint:php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": false
        }
    }
}
